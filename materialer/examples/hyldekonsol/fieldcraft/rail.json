[
  {"command": "model.units", "params": {"system": "mm-t-s-N-MPa"}},
  {"command": "geometry.import.mesh", "params": {"path": "../cad/rail.3mf"}},
  {"command": "mesh.surface.check", "params": {"surface": 0}},
  {"command": "mesh.hex.generate", "params": {"surface": 0, "size": 10, "order": 2}},
  {"command": "model.set.create", "params": {"name": "Skinne", "geometry": [{"body": "Rail_A"}]}},
  {"command": "model.set.create", "params": {"name": "Vaeg", "geometry": [{"body": "Rail_A", "face": "2"}]}},
  {"command": "model.set.create", "params": {"name": "Spids", "geometry": [{"body": "Rail_A", "face": "4"}]}},
  {"command": "model.material.create", "params": {"name": "S235", "elastic": {"type": "isotropic", "young": 210000.0, "poisson": 0.3}}},
